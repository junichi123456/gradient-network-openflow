      },
      {
        "op": "say",
        "who": "protagonist",
        "text": "こっち。"
      },
      {
        "op": "narration",
        "text": "{I}が指したのは、岩の隙間がわずかに広がった、脇の細道だった。"
      },
      {
        "op": "say",
        "who": "partner",
        "text": "えっ……あ、ほんとだ！風が通ってる！すごい、{player_name}！",
        "face": "surprise"
      },
      {
        "op": "say",
        "who": "protagonist",
        "text": "……急ごう。"
      },
      {
        "op": "narration",
        "text": "二人は細道に体をねじ込んで、鉱道の闇へ入っていった。"
      },
      {
        "op": "set_flag",
        "flag": "c03_mine_in"
      }
    ]
